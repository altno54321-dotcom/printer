{
  "name": "Manual Duplex PDF",
  "short_name": "Duplex PDF",
  "description": "Print double-sided documents using your single-sided printer through manual paper flipping.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f8fafc",
